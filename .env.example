# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection — used at runtime by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"

# Direct connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── Session ──────────────────────────────────────────────────────────────────
# HMAC-SHA256 signing secret — must be a long, random, unique string in production.
# Generate with: openssl rand -hex 64
SESSION_SECRET="replace-with-a-long-random-secret"

# ─── Email ────────────────────────────────────────────────────────────────────
# Option A: Gmail SMTP (recommended for low volume)
# Use a 16-character App Password (not your account password).
# Enable at: https://myaccount.google.com/apppasswords
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option B: Resend (recommended for production)
# Sign up at https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="Pearlora <noreply@yourdomain.com>"

# ─── App ──────────────────────────────────────────────────────────────────────
# Full public URL of the app — used in email links and CSRF origin checks
NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Protects /api/cron/booking-reminders — REQUIRED in production.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-secret"

# ─── Payments (mock provider) ─────────────────────────────────────────────────
# Shared secret the payment webhook requires in the `x-webhook-signature` header.
# REQUIRED for /api/webhooks/payment to accept requests — it fails closed without it.
# Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET="replace-with-a-random-secret"

# ─── File storage (Vercel Blob) ───────────────────────────────────────────────
# Persistent object storage for property image uploads. REQUIRED in production —
# Vercel's serverless filesystem is ephemeral/read-only, so local disk uploads do
# not persist. Create a store in the Vercel dashboard (Storage → Blob) and paste
# its read-write token. Without it, uploads fall back to local disk in DEV ONLY.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ─── Optional / future (not required today) ───────────────────────────────────
# Distributed rate limiting — only if you migrate lib/security/rate-limit.ts to Upstash.
# Without these, the in-memory limiter is used (per-serverless-instance; see docs).
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxx"
#
# Error monitoring — only if you add @sentry/nextjs.
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
#
# AI / RAG assistant — kill switch + provider (see docs/rag-readiness-plan.md).
# Feature is off unless AI_ENABLED=true. Nothing AI-related ships until then.
# AI_ENABLED="false"
# AI_PROVIDER_API_KEY=""
